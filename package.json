{
  "name": "order-ops-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server.js",
    "start": "node server.js",
    "backup:production": "node scripts/backup-production-firestore.mjs",
    "migrate:ownership": "node scripts/migrate-member-ownership.mjs",
    "migrate:auth": "node scripts/migrate-firebase-auth.mjs",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore,storage --project demo-skilltest \"node scripts/test-security-rules.mjs\"",
    "test:notifications": "node --test scripts/test-notification-push.mjs",
    "seed:superadmin": "node scripts/seed-superadmin.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
