rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath() {
      return /databases/$(database)/documents/authRoles/$(request.auth.uid);
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    function hasRole() {
      return signedIn() && exists(rolePath());
    }

    function role() {
      return get(rolePath()).data.role;
    }

    function subjectId() {
      return get(rolePath()).data.subjectId;
    }

    function isMember() {
      return hasRole() && role() == 'member';
    }

    function isMemberId(memberId) {
      return signedIn()
        && (
          (isMember() && subjectId() == memberId)
          || (
            exists(memberPath(memberId))
            && get(memberPath(memberId)).data.authUid == request.auth.uid
          )
        );
    }

    function isSuperAdmin() {
      return hasRole() && role() == 'super_admin';
    }

    function isAdmin() {
      return hasRole() && role() == 'admin';
    }

    function isEmployee() {
      return hasRole() && role() == 'employee';
    }

    function isStaff() {
      return isSuperAdmin() || isAdmin() || isEmployee();
    }

    function isFinanceStaff() {
      return isSuperAdmin();
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(fields);
    }

    function hasNoLegacySecrets() {
      return !request.resource.data.keys().hasAny([
        'accountPassword',
        'password',
        'withdrawalPassword'
      ]);
    }

    function memberOrderAfter(orderId) {
      return getAfter(/databases/$(database)/documents/orders/$(orderId));
    }

    function memberTransactionAfter(transactionId) {
      return getAfter(/databases/$(database)/documents/transactions/$(transactionId));
    }

    function isValidOwnerCompletion(memberId) {
      let orderId = request.resource.data.lastCompletedOrderId;
      let orderBefore = get(/databases/$(database)/documents/orders/$(orderId));
      let orderAfter = memberOrderAfter(orderId);
      return changedOnly(['balance', 'totalOrders', 'lastCompletedOrderId'])
        && orderBefore.data.memberId == memberId
        && orderAfter.data.memberId == memberId
        && !(orderBefore.data.status in ['completed', 'diserahkan'])
        && orderAfter.data.status in ['completed', 'diserahkan']
        && orderAfter.data.commissionCreditedAt is string
        && orderAfter.data.commissionCreditedAt.size() > 0
        && request.resource.data.totalOrders == resource.data.totalOrders + 1
        && request.resource.data.balance == resource.data.balance + orderAfter.data.commission;
    }

    function isValidFinanceBalanceChange(memberId) {
      let transactionId = request.resource.data.lastBalanceTransactionId;
      let transactionBefore = get(/databases/$(database)/documents/transactions/$(transactionId));
      let transactionAfter = memberTransactionAfter(transactionId);
      return changedOnly(['balance', 'lastBalanceTransactionId'])
        && transactionAfter.data.memberId == memberId
        && (
          (
            transactionAfter.data.type == 'reward'
            && transactionAfter.data.status == 'approved'
            && request.resource.data.balance == resource.data.balance + transactionAfter.data.amount
          )
          ||
          (
            transactionBefore.data.status == 'pending'
            && transactionAfter.data.status == 'approved'
            && transactionAfter.data.type == 'topup'
            && request.resource.data.balance == resource.data.balance + transactionAfter.data.amount
          )
          ||
          (
            transactionBefore.data.status == 'pending'
            && transactionAfter.data.status == 'approved'
            && transactionAfter.data.type == 'withdrawal'
            && (
              !transactionBefore.data.keys().hasAny(['balanceDeductedAt'])
              || transactionBefore.data.balanceDeductedAt == ''
            )
            && request.resource.data.balance == resource.data.balance - transactionAfter.data.amount
          )
          ||
          (
            transactionBefore.data.status == 'pending'
            && transactionAfter.data.status == 'rejected'
            && transactionAfter.data.type == 'withdrawal'
            && transactionBefore.data.balanceDeductedAt is string
            && transactionBefore.data.balanceDeductedAt.size() > 0
            && request.resource.data.balance == resource.data.balance + transactionAfter.data.amount
          )
        )
        && request.resource.data.balance >= 0;
    }

    function isValidMemberOwnerUpdate(memberId) {
      return isMemberId(memberId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.authEmail == resource.data.authEmail
        && hasNoLegacySecrets()
        && (
          changedOnly(['favoriteProductIds'])
          || changedOnly(['withdrawalPinHash'])
          || changedOnly(['lastLogin'])
          || isValidOwnerCompletion(memberId)
        );
    }

    function isValidStaffProfileUpdate() {
      return isStaff()
        && hasNoLegacySecrets()
        && changedOnly([
          'username',
          'usernameNormalized',
          'phone',
          'phoneNormalized',
          'level'
        ]);
    }

    function isValidSuperAdminMemberUpdate(memberId) {
      return isSuperAdmin()
        && hasNoLegacySecrets()
        && (
          changedOnly([
            'username',
            'usernameNormalized',
            'phone',
            'phoneNormalized',
            'level',
            'withdrawalLocked',
            'withdrawalRemarks'
          ])
          || changedOnly(['withdrawalPinHash'])
          || isValidFinanceBalanceChange(memberId)
        );
    }

    function isValidFinanceMemberUpdate(memberId) {
      return isFinanceStaff()
        && hasNoLegacySecrets()
        && isValidFinanceBalanceChange(memberId);
    }

    function orderBelongsToCurrentMember(data) {
      return isMemberId(data.memberId);
    }

    function isCleanWaitingOrder(data) {
      return data.status == 'waiting_assignment'
        && data.productCode == ''
        && data.productName == ''
        && data.quantity == 0
        && data.assignedProducts.size() == 0
        && data.value == 0
        && data.commission == 0
        && data.requiredBalance == 0;
    }

    function isValidMemberOrderUpdate(orderId) {
      let memberAfter = getAfter(/databases/$(database)/documents/members/$(resource.data.memberId));
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return orderBelongsToCurrentMember(resource.data)
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.member == resource.data.member
        && request.resource.data.referenceNumber == resource.data.referenceNumber
        && changed.hasOnly([
          'status',
          'submittedAt',
          'shippedAt',
          'completedAt',
          'commissionCreditedAt',
          'rating',
          'review',
          'reviewedAt'
        ])
        && request.resource.data.status in [
          'product_assigned',
          'waiting_shipment',
          'belum_diserahkan',
          'diserahkan',
          'completed',
          'rejected'
        ]
        && (
          !(request.resource.data.status in ['completed', 'diserahkan'])
          || (
            memberAfter.data.lastCompletedOrderId == orderId
            && memberAfter.data.totalOrders == get(/databases/$(database)/documents/members/$(resource.data.memberId)).data.totalOrders + 1
          )
        );
    }

    function isValidStaffOrderWrite() {
      return isStaff()
        && request.resource.data.id == resource.data.id
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.member == resource.data.member
        && request.resource.data.referenceNumber == resource.data.referenceNumber;
    }

    function isValidMemberTransactionCreate(transactionId) {
      let memberBefore = get(/databases/$(database)/documents/members/$(request.resource.data.memberId));
      let memberAfter = getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberId));
      return isMemberId(request.resource.data.memberId)
        && request.resource.data.id == transactionId
        && request.resource.data.status == 'pending'
        && request.resource.data.type == 'topup'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100000
        && request.resource.data.amount <= 100000000
        && request.resource.data.member == memberBefore.data.username
        && !request.resource.data.keys().hasAny(['submittedWithdrawalPassword'])
        && memberAfter.data.balance == memberBefore.data.balance;
    }

    function isValidRewardCreate(transactionId) {
      let memberBefore = get(/databases/$(database)/documents/members/$(request.resource.data.memberId));
      let memberAfter = getAfter(/databases/$(database)/documents/members/$(request.resource.data.memberId));
      return isSuperAdmin()
        && request.resource.data.id == transactionId
        && request.resource.data.type == 'reward'
        && request.resource.data.status == 'approved'
        && request.resource.data.amount > 0
        && memberAfter.data.lastBalanceTransactionId == transactionId
        && memberAfter.data.balance == memberBefore.data.balance + request.resource.data.amount;
    }

    function isValidFinanceTransactionUpdate() {
      return isFinanceStaff()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'creditedAt'])
        && request.resource.data.id == resource.data.id
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.type == resource.data.type
        && request.resource.data.amount == resource.data.amount;
    }

    match /members/{memberId} {
      allow get: if isMemberId(memberId) || isStaff();
      allow list: if isStaff();
      allow create: if false;
      allow update: if isValidMemberOwnerUpdate(memberId)
        || isValidStaffProfileUpdate()
        || isValidSuperAdminMemberUpdate(memberId)
        || isValidFinanceMemberUpdate(memberId);
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read: if isStaff() || orderBelongsToCurrentMember(resource.data);
      // Customer orders are created by the authenticated server API, which
      // enforces balance and one-active-task checks with the Admin SDK.
      allow create: if false;
      allow update: if isValidMemberOrderUpdate(orderId) || isValidStaffOrderWrite();
      allow delete: if isSuperAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isStaff() || isMemberId(resource.data.memberId);
      allow create: if isValidMemberTransactionCreate(transactionId) || isValidRewardCreate(transactionId);
      allow update: if isValidFinanceTransactionUpdate();
      allow delete: if isSuperAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /banks/{bankId} {
      allow read: if isSuperAdmin() || isMember();
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /admins/{adminId} {
      allow read: if isStaff();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isStaff()
        && subjectId() == adminId
        && changedOnly(['name', 'username', 'usernameNormalized'])
        && hasNoLegacySecrets()
      );
    }

    match /authRoles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if false;
      allow update, delete: if false;
    }

    match /loginIdentifiers/{identifierId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isStaff();
    }

    match /identityReservations/{reservationId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if isStaff();
    }

    match /invitationCodes/{invitationCode} {
      allow get: if true;
      allow list: if isStaff();
      allow write: if isSuperAdmin();
    }

    match /securityAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorAdminId == subjectId();
      allow update, delete: if false;
    }

    // The inbox content is derived from records already visible to each account.
    // Only the authenticated owner can store read/clear markers for their inbox.
    match /notificationStates/{uid}/items/{eventId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['readAt', 'clearedAt'])
        && (!request.resource.data.keys().hasAny(['readAt']) || request.resource.data.readAt is timestamp)
        && (!request.resource.data.keys().hasAny(['clearedAt']) || request.resource.data.clearedAt is timestamp);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
